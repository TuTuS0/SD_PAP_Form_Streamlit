# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud secrets.
# Keep the shared secret server-side. See google_drive/SETUP_FR.md.
[storage]
backend = "google_drive"

[google_drive]
web_app_url = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
shared_secret = "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Alternative: set storage.backend to "supabase" and configure this section.
# [supabase]
# url = "https://YOUR_PROJECT.supabase.co"
# secret_key = "sb_secret_REPLACE_ME"
